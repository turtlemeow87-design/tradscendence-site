---
import BaseLayout from "../layouts/BaseLayout.astro";

// ✅ Your Formspree endpoint
const FORMSPREE_ENDPOINT = "https://formspree.io/f/mblzzrqb";

/** Mark items that have already been purchased.
 *  Keyed by item.id so the UI keeps working even if you reorder the list.
 *  Example: "small-coil-008-strings": 1,
 */
const ORDERED_COUNTS: Record<string, number> = {};

// Edit this array to add/remove items. `description` is optional — a line shown under the title.
const WISHLIST: { id: string; name: string; description?: string; url: string }[] = [
  { id: "small-coil-008-strings", name: "Small Coil of .008\" strings", description: "(Choose .008\" from the list)", url: "https://www.musiciansmallusa.com/steel-wire-small-coil/" },
];
---

<BaseLayout title="My Wish List — Tradscendence" description="Hunter’s wish list — items supporters can buy.">
  <section class="mx-auto max-w-3xl px-4 py-10 space-y-8">
    <header class="space-y-3 text-center">
      <h1 class="font-display text-3xl md:text-4xl">My Wish List</h1>
      <div class="opacity-80 max-w-xl mx-auto text-sm leading-relaxed">
        <p>Welcome to the secret page on my website.</p>
        <p>The best gift I can possibly get are accessories and strings!</p>
        <p class="mt-3">Items may show a small badge like <span class="align-middle inline-flex items-center gap-1 px-2 py-0.5 rounded-md border border-[var(--accent-bronze)]/60 text-[12px]">● Somebody already ordered!! ×1</span>. That simply means someone has generously purchased this once already.</p>
        <p class="mt-3"><strong>Important:</strong> After you’ve purchased, please check the big box so I get a notification and can keep the list tidy. I don’t see who purchased it — just that it was marked.</p>
      </div>
    </header>

    <ul id="wish-list" data-endpoint={FORMSPREE_ENDPOINT} class="space-y-6">
      {WISHLIST.map((item, idx) => {
        const orderedCount = ORDERED_COUNTS[item.id] ?? 0;
        return (
          <li
            class="frame rounded-xl border border-[var(--accent-bronze)]/70 p-5 flex flex-col gap-5"
            data-item-id={item.id}
            data-item-name={item.name}
            data-item-url={item.url}
            data-item-number={(idx + 1).toString()}
            data-ordered-count={orderedCount.toString()}
          >
            <div class="flex items-start gap-3">
              <span class="inline-flex h-7 w-7 items-center justify-center rounded-full border border-[var(--accent-bronze)] text-xs mt-1">
                {idx + 1}
              </span>
              <div class="flex-1">
                <div class="flex flex-wrap items-center gap-2">
                  <h2 class="item-title font-semibold text-lg">{item.name}</h2>
                  {orderedCount > 0 && (
  <span
    class="ordered-badge inline-flex items-center gap-1.5 px-3 py-1 rounded-full
           bg-[#6E2A2A] text-[#F8F6F2] font-semibold text-[12px] tracking-tight
           ring-1 ring-[rgba(194,164,95,0.55)] shadow-[0_4px_18px_rgba(110,42,42,0.45)]
           transition-transform duration-150"
  >
    <span class="relative inline-block h-2.5 w-2.5">
      <span class="absolute inset-0 rounded-full bg-[rgba(255,255,255,0.35)] animate-ping"></span>
      <span class="absolute inset-[3px] rounded-full bg-[#F8F6F2]"></span>
    </span>
    Somebody already ordered ×<span class="ordered-count">{orderedCount}</span>
  </span>
)}



                </div>

                {item.description && (
                  <p class="item-description mt-1 text-sm opacity-80">{item.description}</p>
                )}

                <a
                  href={item.url}
                  target="_blank"
                  rel="noopener"
                  class="mt-2 inline-block px-4 py-2 rounded-lg border border-[var(--accent-gold)] text-[var(--accent-gold)] text-base font-semibold tracking-wide hover:bg-[var(--accent-gold)] hover:text-ebony transition"
                >
                  🛒 Click here to purchase
                </a>
              </div>
            </div>

            <div class="flex items-center gap-4 pl-10 sm:pl-12">
              <input
                type="checkbox"
                class="appearance-none relative h-9 w-9 shrink-0 border-2 border-[var(--accent-bronze)] rounded-md cursor-pointer
                      transition-colors duration-200 ease-in-out
                      checked:bg-[var(--accent-gold)] checked:border-[var(--accent-gold)]
                      before:content-[''] before:absolute before:inset-0 before:flex before:items-center before:justify-center
                      before:scale-0 checked:before:scale-100
                      before:text-ebony before:font-bold before:text-lg
                      before:content-['✔']"
                data-checkbox
                aria-label={`Notify purchase of ${item.name}`}
              />
              <span class="text-base font-medium text-ivory opacity-80 leading-tight">
                ✅ Please check the box to the left once you’ve purchased this item
              </span>
            </div>
          </li>
        );
      })}
    </ul>

    <!-- No-JS fallback -->
    <noscript>
      <div class="mt-8 p-4 border rounded-xl border-[var(--accent-bronze)]/70">
        <p class="text-sm mb-2">JavaScript is off. Use this fallback to notify me:</p>
        <form action={FORMSPREE_ENDPOINT} method="POST" class="grid gap-2">
          <label class="text-sm">
            Which item?
            <select name="item_number" class="bg-ebony/60 frame rounded-xl px-3 py-2 border border-[var(--accent-bronze)]">
              {WISHLIST.map((item, idx) => (
                <option value={idx + 1}>{idx + 1} — {item.name}</option>
              ))}
            </select>
          </label>
          <input type="hidden" name="_subject" value="Wishlist (noscript) submission" />
          <input type="hidden" name="form_name" value="wishlist-click-noscript" />
          <input type="text" name="_gotcha" class="hidden" tabindex="-1" autocomplete="off" />
          <button class="px-3 py-2 rounded-xl border border-[var(--accent-bronze)] hover:bg-white/5" type="submit">
            Send notification
          </button>
        </form>
      </div>
    </noscript>
  </section>

  <script>
    (function () {
      const list = document.getElementById("wish-list");
      if (!list) return;

      const ENDPOINT = list.dataset.endpoint;
      if (!ENDPOINT) {
        console.error("Formspree endpoint missing. Set FORMSPREE_ENDPOINT in the page.");
        return;
      }

      function findBadgeEls(li) {
        return {
          badge: li.querySelector(".ordered-badge"),
          countEl: li.querySelector(".ordered-count"),
        };
      }

      async function notifyFormspree(payload) {
        const res = await fetch(ENDPOINT, {
          method: "POST",
          headers: { "Content-Type": "application/json", "Accept": "application/json" },
          body: JSON.stringify(payload),
        });
        if (!res.ok) {
          const text = await res.text().catch(() => "");
          throw new Error(`Formspree ${res.status}: ${text || "request failed"}`);
        }
        return res.json().catch(() => ({}));
      }

      [...list.querySelectorAll("li[data-item-id]")].forEach((li) => {
        const cb = li.querySelector("[data-checkbox]");
        if (!cb) return;

        cb.addEventListener("click", async (e) => {
          e.preventDefault(); // treat checkbox as a button

          const item = {
            id: li.getAttribute("data-item-id"),
            name: li.getAttribute("data-item-name"),
            url: li.getAttribute("data-item-url"),
            number: li.getAttribute("data-item-number"),
          };

          cb.disabled = true;

          const payload = {
            _subject: `Wishlist: Item #${item.number} — ${item.name}`,
            form_name: "wishlist-click",
            item_number: item.number,
            item_id: item.id,
            item_name: item.name,
            item_url: item.url,
            page_path: location.pathname,
            page_title: document.title,
            tz: Intl.DateTimeFormat().resolvedOptions().timeZone || "unknown",
            when_iso: new Date().toISOString(),
            ua: navigator.userAgent,
            _gotcha: "",
          };

          try {
            await notifyFormspree(payload);

            // Visually mark the item and bump the "Already ordered ×N" badge
            li.classList.add("opacity-60");
            const note = cb.nextElementSibling;
            note.textContent = "🎉 Thank you! This item’s been marked purchased.";
            note.classList.add("text-[var(--accent-gold)]");

            // Update ordered count badge (create it if it doesn't exist yet)
            const current = parseInt(li.dataset.orderedCount || "0", 10) || 0;
            const next = current + 1;
            li.dataset.orderedCount = String(next);

            const { badge, countEl } = findBadgeEls(li);
            if (badge && countEl) {
              countEl.textContent = String(next);
            } else {
              // Insert a fresh badge next to the title
              const titleRow = li.querySelector(".item-title")?.parentElement;
              if (titleRow) {
                const span = document.createElement("span");
                span.className =
  "ordered-badge inline-flex items-center gap-1.5 px-3 py-1 rounded-full " +
  "bg-[#6E2A2A] text-[#F8F6F2] font-semibold text-[12px] tracking-tight " +
  "ring-1 ring-[rgba(194,164,95,0.55)] shadow-[0_4px_18px_rgba(110,42,42,0.45)] " +
  "transition-transform duration-150";

span.innerHTML =
  '<span class="relative inline-block h-2.5 w-2.5">' +
    '<span class="absolute inset-0 rounded-full bg-[rgba(255,255,255,0.35)] animate-ping"></span>' +
    '<span class="absolute inset-[3px] rounded-full bg-[#F8F6F2]"></span>' +
  '</span> ' +
  'Already ordered ×<span class="ordered-count"></span>';


                titleRow.appendChild(span);
                span.querySelector(".ordered-count").textContent = String(next);
              }
            }
          } catch (err) {
            console.error(err);
            const note = cb.nextElementSibling;
            note.textContent = "❌ Couldn’t send — please try again.";
            note.classList.add("text-red-400");
          } finally {
            cb.disabled = false;
          }
        });
      });
    })();
  </script>
</BaseLayout>
